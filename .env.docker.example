# =============================================================================
# GameHub · variables de entorno para DOCKER LOCAL
#
#   cp .env.docker.example .env.docker
#
# .env.docker NO se versiona: está excluido por .gitignore (.env.*).
# Rellena APP_KEY, DB_PASSWORD y DB_ROOT_PASSWORD antes de arrancar.
#
# Genera una APP_KEY nueva (no reutilices la de otro entorno):
#   php artisan key:generate --show
# =============================================================================

APP_NAME=GameHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Puerto publicado por Nginx en el host (http://localhost:8080)
APP_PORT=8080
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Cuenta administradora inicial (database/seeders/AdminUserSeeder.php)
# -----------------------------------------------------------------------------
ADMIN_NAME="Administrador GameHub"
ADMIN_EMAIL=admin@gamehub.test
# En local se usa "password" si se deja vacío. En producción se genera una
# contraseña aleatoria y se muestra una única vez por consola.
# ADMIN_PASSWORD=

# Los logs salen por stdout/stderr: se ven con "docker compose logs -f app".
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# MySQL 8.4 (contenedor "db")
#
# DB_HOST es el nombre del servicio en docker-compose.yml, no 127.0.0.1.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gamehub
DB_USERNAME=gamehub
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-clave-de-root

# Puerto del host para conectar con un cliente SQL (3307 evita XAMPP en 3306).
DB_PORT_HOST=3307

# -----------------------------------------------------------------------------
# Sesiones, caché y colas
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Comportamiento del contenedor al arrancar
# -----------------------------------------------------------------------------
# Ejecuta "php artisan migrate --force" al iniciar (cómodo en local).
RUN_MIGRATIONS=true

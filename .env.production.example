# Plantilla de variables para PRODUCCIÓN en Laravel Cloud.
#
# No rellenes este archivo con valores reales y lo subas al repositorio.
# En Laravel Cloud las variables se definen en Environment > Settings >
# Environment Variables. Laravel Cloud escribe esas variables en un .env
# antes de arrancar la aplicación.
#
# NUNCA subas secretos (APP_KEY, contraseñas, tokens) al repositorio.

APP_NAME=GameHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-entorno.laravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Laravel Cloud captura stdout/stderr para el visor de logs.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Base de datos: Laravel MySQL
# ---------------------------------------------------------------------------
# Laravel Cloud INYECTA automáticamente DB_HOST, DB_USERNAME, DB_PASSWORD y
# DB_DATABASE al adjuntar la base de datos al entorno.
#
# No definas esas cuatro variables a mano: las variables personalizadas tienen
# prioridad y sobrescribirían las credenciales inyectadas.
DB_CONNECTION=mysql
DB_PORT=3306

# ---------------------------------------------------------------------------
# Sesiones, caché y colas
# ---------------------------------------------------------------------------
# Los entornos de Laravel Cloud son efímeros: sesiones y caché deben vivir en
# la base de datos (o en Valkey/Redis). Nunca uses "file" en producción.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database

# La aplicación no usa colas: "sync" evita mantener un worker.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Almacenamiento
# ---------------------------------------------------------------------------
# La app solo guarda image_url como texto; no sube archivos.
# Si en el futuro se añaden subidas, usa Laravel Cloud Object Storage (S3).
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Correo (la app no envía correos: no hay verificación ni recuperación)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tu-dominio.example"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend (se compila durante el build)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

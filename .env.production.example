# =============================================================================
# GameHub · variables de entorno para PRODUCCIÓN (Docker Compose en VPS Ubuntu)
#
#   cp .env.production.example .env.production
#
# .env.production NO se versiona: está excluido por .gitignore (.env.*).
# NUNCA subas este archivo relleno al repositorio.
#
# Genera una APP_KEY nueva y exclusiva de producción:
#   php artisan key:generate --show
# =============================================================================

APP_NAME=GameHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Dominio público y puerto del host que publica Nginx.
APP_URL=https://tu-dominio.example
HTTP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Cuenta administradora inicial (database/seeders/AdminUserSeeder.php)
#
# Define ADMIN_PASSWORD con una contraseña larga o deja que el seeder genere
# una aleatoria la primera vez (se muestra una sola vez por consola).
# -----------------------------------------------------------------------------
ADMIN_NAME="Administrador GameHub"
ADMIN_EMAIL=admin@tu-dominio.example
# ADMIN_PASSWORD=

# Docker y Laravel capturan stdout/stderr.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# MySQL 8.4 (contenedor "db", red interna)
#
# DB_HOST es el nombre del servicio de docker-compose.prod.yml.
# Estas mismas variables crean la base de datos en el primer arranque.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gamehub
DB_USERNAME=gamehub
DB_PASSWORD=cambia-esta-contrasena-larga
DB_ROOT_PASSWORD=cambia-esta-clave-de-root-larga

# -----------------------------------------------------------------------------
# Sesiones, caché y colas
# -----------------------------------------------------------------------------
# SESSION_SECURE_COOKIE=true exige HTTPS. Si pruebas el compose de producción
# por HTTP antes de configurar TLS, ponlo en false temporalmente.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tu-dominio.example"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Comportamiento del contenedor al arrancar
# -----------------------------------------------------------------------------
# En producción las migraciones se lanzan a mano y de forma controlada:
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#     exec app php artisan migrate --force
RUN_MIGRATIONS=false

# APP_OPTIMIZE lo fija docker-compose.prod.yml en "true".
